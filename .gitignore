# ============================================================
# NutriQ Application Root .gitignore
# ============================================================

# Environment variables & secrets
.env
.env.*
.env.local
.env.development
.env.production
.env.staging
.env.test
!.env.example

# Python virtual environments & bytecode
venv/
.venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/

# Node / Frontend build outputs & dependencies
node_modules/
dist/
build/
.vite/
dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Database files, WAL journal files, and automated backups
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.bak
*.backup
*.backup_*
nutriq.db*

# Logs & temporary files
*.log
*.tmp
*.temp

# Certificates & keys
*.pem
*.key
*.crt

# IDE, Editor & OS metadata
.vscode/
.idea/
.DS_Store
Thumbs.db
