# ============================================================
# NUTRIQ BACKEND ENVIRONMENT CONFIGURATION (.env.example)
# ============================================================

# App Configuration
APP_NAME=NutriQ Backend
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api
APP_URL=http://localhost:5173

# Database (SQLite default or PostgreSQL/MySQL)
DATABASE_URL=sqlite+aiosqlite:///./nutriq.db

# JWT & Security
JWT_SECRET=nutriq-super-secure-production-secret-key-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Email Service Configuration (Resend or SMTP)
# EMAIL_PROVIDER: "resend" (recommended), "smtp", "console", or "mock"
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_your_resend_api_key_here
WELCOME_EMAIL_FROM=NutriQ <onboarding@resend.dev>

# Optional SMTP fallback
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_USE_TLS=true
EMAIL_FROM=NutriQ <no-reply@nutriq.app>

# Password Reset & Rate Limiting
PASSWORD_RESET_EXPIRE_MINUTES=30
FORGOT_PASSWORD_RATE_LIMIT_SECONDS=60

# Google OAuth 2.0
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Google Gemini AI Configuration
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.6-flash

# Optional Third-Party Services
ANTHROPIC_API_KEY=
VISION_API_KEY=
SPEECH_API_KEY=
SENTRY_DSN=
FCM_CONFIG=
BILLING_PROVIDER_KEY=
