# NutriQ Application Environment Configuration

APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api

# Database (PostgreSQL for staging/production; SQLite for local testing)
DATABASE_URL=sqlite+aiosqlite:///./nutriq.db
# DATABASE_URL=postgresql+asyncpg://nutriq_user:password@localhost:5432/nutriq_db

# Security & Authentication
JWT_SECRET=nutriq-super-secure-production-secret-key-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# AI Provider (Anthropic Claude)
ANTHROPIC_API_KEY=
AI_DEFAULT_MODEL=claude-3-7-sonnet-20250219
AI_FAST_MODEL=claude-3-5-haiku-20241022
AI_DAILY_LIMIT_FREE=15
AI_DAILY_LIMIT_PREMIUM=200

# Deterministic Engine Constants
SAFE_MIN_CALORIES=1200
SAFE_MAX_CALORIES=5000
GOAL_RULE_VERSION=2.0

# Optional Third-Party Services
VISION_API_KEY=
SPEECH_API_KEY=
SENTRY_DSN=
FCM_CONFIG=
BILLING_PROVIDER_KEY=
